PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8100,http://127.0.0.1:8100
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
SESSION_HOURS=24
MAX_UPLOAD_MB=100
USER_STORAGE_MB=2048
# IA semântica opcional (Ollama local com o modelo instalado)
OLLAMA_URL=
EMBEDDING_MODEL=embeddinggemma
# Processamento real de áudio opcional; veja audio/README.md
AUDIO_ENABLED=false
AUDIO_PYTHON=python
AUDIO_TIMEOUT_SECONDS=1800
